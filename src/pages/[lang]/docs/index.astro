---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, isRTL } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fa' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const rtl = isRTL(lang);
const isFa = lang === 'fa';

const allDocs = await getCollection('docs');
const currentLangDocs = allDocs
  .filter((d) => d.data.lang === lang)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const sections = Array.from(new Set(currentLangDocs.map((d) => d.data.section)));

const getCleanDocSlug = (slug: string) => {
  const parts = slug.split('/');
  return parts.length > 1 ? parts.slice(1).join('/') : slug;
};
---

<BaseLayout
  title={`${t('docs.title')} | Apadana Linux`}
  description={t('docs.subtitle')}
  lang={lang}
>
  <div class="py-14 lg:py-20 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Hero / Header -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          {t('docs.title')}
        </h1>
        <p class="text-slate-400 text-base sm:text-lg leading-relaxed font-light">
          {t('docs.subtitle')}
        </p>

        <!-- Quick Start CTA -->
        <div class="pt-2">
          <a
            href={`/${lang}/docs/overview`}
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-md font-semibold text-xs text-white bg-parch hover:opacity-95 shadow-sm transition-all"
          >
            <span>{isFa ? 'شروع با معرفی آپادانا' : 'Start with Apadana Overview'}</span>
            <svg class={`w-3.5 h-3.5 ${rtl ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Sections Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {sections.map((section) => {
          const sectionDocs = currentLangDocs.filter((d) => d.data.section === section);
          return (
            <div class="enterprise-card rounded-lg p-5 border border-white/10 flex flex-col justify-between hover:border-parch-teal/30 transition-all space-y-4">
              <div class="space-y-3">
                <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
                  <h2 class="font-bold text-white text-sm">
                    {section}
                  </h2>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-secondary text-slate-400">
                    {sectionDocs.length} {isFa ? 'راهنما' : 'docs'}
                  </span>
                </div>

                <ul class="space-y-1.5">
                  {sectionDocs.map((doc) => (
                    <li>
                      <a
                        href={`/${lang}/docs/${getCleanDocSlug(doc.slug)}`}
                        class="group block p-2 rounded hover:bg-secondary/60 transition-colors"
                      >
                        <div class="text-xs font-semibold text-slate-200 group-hover:text-parch-teal transition-colors">
                          {doc.data.title}
                        </div>
                        <div class="text-[11px] text-slate-400 line-clamp-1 mt-0.5 font-light">
                          {doc.data.description}
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-2 border-t border-white/5">
                <a
                  href={`/${lang}/docs/${getCleanDocSlug(sectionDocs[0].slug)}`}
                  class="text-[11px] font-medium text-parch-teal hover:underline inline-flex items-center gap-1"
                >
                  <span>{isFa ? 'مرور این بخش' : 'Explore section'}</span>
                  <span class={rtl ? 'rotate-180' : ''}>→</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </div>
</BaseLayout>
