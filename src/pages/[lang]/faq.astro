---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqList } from '../../data/faq';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fa' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const isFa = lang === 'fa';

// Extract categories
const categories = Array.from(new Set(faqList.map((item) => item.category[lang])));
---

<BaseLayout
  title={isFa ? 'پرسش‌های متداول (FAQ) | آپادانا لینوکس' : 'Frequently Asked Questions (FAQ) | Apadana Linux'}
  description={isFa ? 'پاسخ به سوالات متداول درباره آپادانا لینوکس، معماری تغییرناپذیر، تفاوت با پارچ و پشتیبانی سازمانی.' : 'Frequently asked questions about Apadana Linux, immutability, relation to Parch, and enterprise support.'}
  lang={lang}
>
  <div class="py-14 lg:py-20 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Page Header -->
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          {isFa ? 'پرسش‌های متداول' : 'Frequently Asked Questions'}
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed font-light">
          {isFa
            ? 'پاسخ به ۲۰ پرسش کلیدی سازمان‌ها و مدیران فنی درباره هویت آپادانا، معماری تغییرناپذیر، مدل تجاری و پشتیبانی.'
            : 'Answers to key technical, architectural, and commercial inquiries about Apadana Linux.'}
        </p>
      </div>

      <!-- Live Search Box & Category Filters -->
      <div class="space-y-4 max-w-xl mx-auto">
        <div class="relative">
          <input
            type="text"
            id="faq-search"
            placeholder={isFa ? 'جستجو در میان پرسش‌ها و پاسخ‌ها...' : 'Search questions and answers...'}
            class="w-full px-4 py-3 rounded-lg bg-[#0b1322] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors placeholder:text-slate-500"
          />
          <svg class={`w-4 h-4 text-slate-500 absolute top-3.5 ${isFa ? 'left-3.5' : 'right-3.5'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Category Badges -->
        <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1">
          <button
            type="button"
            class="faq-cat-btn px-2.5 py-1 rounded text-xs font-medium bg-parch text-white transition-colors"
            data-cat="all"
          >
            {isFa ? 'همه موارد' : 'All'}
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              class="faq-cat-btn px-2.5 py-1 rounded text-xs font-medium bg-secondary text-slate-300 hover:text-white border border-white/10 transition-colors"
              data-cat={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- FAQ Accordion List -->
      <div id="faq-container" class="space-y-4">
        {faqList.map((item, index) => (
          <div class="faq-item enterprise-card rounded-lg border border-white/10 overflow-hidden transition-all" data-cat={item.category[lang]}>
            <button
              type="button"
              class="faq-toggle w-full p-5 text-start flex items-center justify-between gap-4 hover:bg-white/5 transition-colors focus:outline-none"
              aria-expanded="false"
            >
              <div class="flex items-start gap-3">
                <span class="text-xs font-mono font-bold text-parch-teal mt-0.5 shrink-0">
                  {isFa ? `.${index + 1}` : `#${index + 1}`}
                </span>
                <span class="font-bold text-sm sm:text-base text-white">
                  {item.q[lang]}
                </span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-secondary text-slate-400 border border-white/5 hidden sm:inline-block">
                  {item.category[lang]}
                </span>
                <svg class="faq-icon w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </button>
            <div class="faq-content hidden px-5 pb-5 pt-1 text-xs sm:text-sm text-slate-300 leading-relaxed font-light border-t border-white/5 bg-[#070e1b]">
              <p class="pt-2">{item.a[lang]}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Footer Callout -->
      <div class="rounded-lg p-6 enterprise-card border border-parch-teal/30 bg-[#071322] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-start">
          <div class="font-bold text-white text-sm">
            {isFa ? 'پرسش دیگری دارید که در لیست نیست؟' : 'Have a question not listed here?'}
          </div>
          <div class="text-xs text-slate-400 font-light">
            {isFa ? 'تیم فنی و تجاری آپادانا آماده پاسخگویی به سازمان شماست.' : 'Our solutions engineering team is available to assist.'}
          </div>
        </div>
        <a
          href={`/${lang}/contact`}
          class="px-5 py-2.5 rounded-md font-semibold text-xs text-white bg-parch hover:opacity-95 shadow-sm transition-all whitespace-nowrap"
        >
          {t('nav.contact')}
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  // Accordion toggle
  const items = document.querySelectorAll('.faq-item');
  items.forEach((item) => {
    const btn = item.querySelector('.faq-toggle');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('.faq-icon');

    if (btn && content && icon) {
      btn.addEventListener('click', () => {
        const isOpen = !content.classList.contains('hidden');
        if (isOpen) {
          content.classList.add('hidden');
          icon.classList.remove('rotate-180');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          content.classList.remove('hidden');
          icon.classList.add('rotate-180');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  });

  // Search and Category filter
  const searchInput = document.getElementById('faq-search') as HTMLInputElement | null;
  const catButtons = document.querySelectorAll('.faq-cat-btn');
  let currentCategory = 'all';

  function filterItems() {
    const term = searchInput?.value.toLowerCase().trim() || '';
    items.forEach((item) => {
      const text = item.textContent?.toLowerCase() || '';
      const cat = (item as HTMLElement).dataset.cat || '';
      const matchesSearch = text.includes(term);
      const matchesCat = currentCategory === 'all' || cat === currentCategory;

      if (matchesSearch && matchesCat) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterItems);
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => {
        b.classList.remove('bg-parch', 'text-white');
        b.classList.add('bg-secondary', 'text-slate-300');
      });
      btn.classList.add('bg-parch', 'text-white');
      btn.classList.remove('bg-secondary', 'text-slate-300');
      currentCategory = (btn as HTMLElement).dataset.cat || 'all';
      filterItems();
    });
  });
</script>
