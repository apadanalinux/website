---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqList } from '../../data/faq';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'fa' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const isFa = lang === 'fa';
---

<BaseLayout
  title={isFa ? 'درخواست استقرار سازمانی و مشاوره | آپادانا لینوکس' : 'Enterprise Inquiries & Consultation | Apadana Linux'}
  description={isFa ? 'فرم استعلام قیمت، درخواست دمو آزمایشی و خدمات پشتیبانی سازمانی آپادانا لینوکس.' : 'Request enterprise trials, SLA quotes, and workstation deployment assistance from Apadana Linux.'}
  lang={lang}
>
  <div class="py-14 lg:py-20 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Header -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          {t('contact.title')}
        </h1>
        <p class="text-slate-400 text-base sm:text-lg leading-relaxed font-light">
          {t('contact.subtitle')}
        </p>
      </div>

      <!-- Main Contact Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Contact Form (7 cols) -->
        <div class="lg:col-span-7 enterprise-card rounded-lg p-6 sm:p-8 border border-white/10 shadow-lg">
          <form id="enterprise-inquiry-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Name -->
              <div class="space-y-1.5">
                <label for="name" class="block text-xs font-semibold text-slate-300">
                  {t('contact.form_name')} *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                  placeholder={isFa ? 'مثال: علی محمدی' : 'e.g. Alex Morgan'}
                />
              </div>

              <!-- Organization -->
              <div class="space-y-1.5">
                <label for="org" class="block text-xs font-semibold text-slate-300">
                  {t('contact.form_org')} *
                </label>
                <input
                  type="text"
                  id="org"
                  name="org"
                  required
                  class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                  placeholder={isFa ? 'نام شرکت یا نهاد' : 'Company Name'}
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Email -->
              <div class="space-y-1.5">
                <label for="email" class="block text-xs font-semibold text-slate-300">
                  {t('contact.form_email')} *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                  placeholder="name@company.com"
                />
              </div>

              <!-- Phone -->
              <div class="space-y-1.5">
                <label for="phone" class="block text-xs font-semibold text-slate-300">
                  {t('contact.form_phone')}
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                  placeholder={isFa ? '۰۹۱۲...' : '+1 (555) 000-0000'}
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Workstation Count -->
              <div class="space-y-1.5">
                <label for="seats" class="block text-xs font-semibold text-slate-300">
                  {t('contact.form_seats')}
                </label>
                <select
                  id="seats"
                  name="seats"
                  class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                >
                  <option value="1-50">1 - 50 {isFa ? 'ایستگاه کاری' : 'Workstations'}</option>
                  <option value="50-200">50 - 200 {isFa ? 'ایستگاه کاری' : 'Workstations'}</option>
                  <option value="200-1000">200 - 1,000 {isFa ? 'ایستگاه کاری' : 'Workstations'}</option>
                  <option value="1000+">1,000+ {isFa ? 'ایستگاه کاری (Enterprise Fleet)' : 'Workstations (Enterprise Fleet)'}</option>
                </select>
              </div>

              <!-- Inquiry Type -->
              <div class="space-y-1.5">
                <label for="inquiry_type" class="block text-xs font-semibold text-slate-300">
                  {t('contact.form_type')}
                </label>
                <select
                  id="inquiry_type"
                  name="inquiry_type"
                  class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                >
                  <option value="poc">{t('contact.type_poc')}</option>
                  <option value="support">{t('contact.type_support')}</option>
                  <option value="custom">{t('contact.type_custom')}</option>
                  <option value="partnership">{t('contact.type_partnership')}</option>
                </select>
              </div>
            </div>

            <!-- Message -->
            <div class="space-y-1.5">
              <label for="message" class="block text-xs font-semibold text-slate-300">
                {t('contact.form_message')}
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                class="w-full px-3.5 py-2 rounded-md bg-[#070e1b] border border-white/10 text-white text-sm focus:outline-none focus:border-parch-teal transition-colors"
                placeholder={isFa ? 'توضیحات مربوط به زیرساخت فعلی، نرم‌افزارهای کلیدی سازمان، یا زمان‌بندی استقرار...' : 'Provide details on your current fleet, target applications, or migration timeline...'}
              ></textarea>
            </div>

            <!-- Success Alert Placeholder -->
            <div id="form-success-msg" class="hidden p-3 rounded-md bg-[#0c2a20] border border-emerald-500/40 text-emerald-300 text-xs font-medium">
              ✔ {t('contact.form_success')}
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full py-3 px-6 rounded-md font-semibold text-xs text-white bg-parch hover:opacity-95 shadow-sm transition-all"
            >
              {t('contact.form_submit')}
            </button>
          </form>
        </div>

        <!-- Sidebar Info & Direct Channels (5 cols) -->
        <div class="lg:col-span-5 space-y-5">
          
          <div class="enterprise-card rounded-lg p-6 border border-white/10 space-y-5">
            <h3 class="font-bold text-base text-white">
              {t('contact.info_title')}
            </h3>

            <div class="space-y-3 text-xs sm:text-sm">
              <div class="p-3.5 rounded bg-secondary border border-white/5 space-y-0.5">
                <div class="text-slate-400 text-xs font-medium">
                  {isFa ? 'بخش تجاری و قراردادها' : 'Commercial & Licensing'}
                </div>
                <div class="font-mono text-parch-teal font-semibold text-sm">
                  enterprise@apadanalinux.ir
                </div>
              </div>

              <div class="p-3.5 rounded bg-secondary border border-white/5 space-y-0.5">
                <div class="text-slate-400 text-xs font-medium">
                  {isFa ? 'پشتیبانی فنی و مهندسی' : 'Technical Support Desk'}
                </div>
                <div class="font-mono text-cyan-400 font-semibold text-sm">
                  support@apadanalinux.ir
                </div>
              </div>

              <div class="p-3.5 rounded bg-secondary border border-white/5 space-y-0.5">
                <div class="text-slate-400 text-xs font-medium">
                  {isFa ? 'کانال تلگرام رسمی' : 'Official Telegram Channel'}
                </div>
                <a href="https://t.me/apadanalinux" target="_blank" rel="noopener noreferrer" class="font-mono text-parch-teal hover:underline font-semibold text-sm inline-flex items-center gap-1.5">
                  <span>@apadanalinux</span>
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.121l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.196 1.006.128.832.942z"/>
                  </svg>
                </a>
              </div>

              <div class="p-3.5 rounded bg-secondary border border-white/5 space-y-0.5">
                <div class="text-slate-400 text-xs font-medium">
                  {isFa ? 'شبکه فدیورس / ماستودون' : 'Fediverse / Mastodon'}
                </div>
                <a href="https://fosstodon.org/@apadana" target="_blank" rel="me noopener noreferrer" class="font-mono text-parch-teal hover:underline font-semibold text-sm inline-flex items-center gap-1.5">
                  <span>@apadana@fosstodon.org</span>
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.68 1.492 2.64.978 5.313.376 8.448.066 11.666.066 14.887c.07 3.395.438 6.76 1.107 10.089.049.245.245.422.495.422h4.088c.27 0 .49-.22.49-.49v-3.79c0-.27-.22-.49-.49-.49-.27 0-.49-.22-.49-.49 0-1.85-.02-3.7-.02-5.55 0-3.693 2.112-5.748 6.336-5.748h.03c4.224 0 6.336 2.055 6.336 5.748 0 1.85-.02 3.7-.02 5.55 0 .27-.22.49-.49.49-.27 0-.49.22-.49.49v3.79c0 .27.22.49.49.49h4.088c.25 0 .446-.177.495-.422.67-3.329 1.037-6.694 1.107-10.089 0-3.22-.31-6.439-.912-9.574z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Enterprise Assurance Card -->
          <div class="p-5 rounded-lg enterprise-card border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-parch-teal text-xs font-bold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>{isFa ? 'تضمین محرمانگی و امنیت سازمانی' : 'Enterprise Confidentiality'}</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed font-light">
              {isFa
                ? 'کلیه اطلاعات ارسالی سازمان‌ها تحت توافق‌نامه محرمانگی (NDA) نگهداری شده و مشاوره اولیه توسط مهندسان ارشد سیستم ارائه می‌گردد.'
                : 'All submissions are treated under strict enterprise confidentiality. Initial consultations are handled directly by principal systems engineers.'}
            </p>
          </div>

        </div>

      </div>

      <!-- FAQ Section (Displaying 20 FAQs with Accordions) -->
      <div class="space-y-6 pt-10 border-t border-white/10">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-white">
              {t('contact.faq_title')}
            </h2>
            <p class="text-xs text-slate-400 font-light mt-0.5">
              {isFa ? 'پاسخ به سوالات پرتکرار سازمان‌ها و مدیران شبکه' : 'Frequently asked questions regarding Apadana Linux'}
            </p>
          </div>
          <a
            href={`/${lang}/faq`}
            class="text-xs text-parch-teal hover:underline font-semibold"
          >
            {isFa ? 'مشاهده همه ۲۰ پرسش ←' : 'View all 20 FAQs →'}
          </a>
        </div>

        <div class="space-y-3">
          {faqList.slice(0, 6).map((item) => (
            <div class="faq-item enterprise-card rounded-lg border border-white/10 overflow-hidden">
              <button
                type="button"
                class="faq-toggle w-full p-4 text-start flex items-center justify-between gap-4 hover:bg-white/5 transition-colors focus:outline-none"
              >
                <span class="font-bold text-xs sm:text-sm text-white">
                  {item.q[lang]}
                </span>
                <svg class="faq-icon w-3.5 h-3.5 text-slate-400 transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-4 pb-4 pt-1 text-xs text-slate-300 leading-relaxed font-light border-t border-white/5 bg-[#070e1b]">
                <p class="pt-1.5">{item.a[lang]}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center pt-2">
          <a
            href={`/${lang}/faq`}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-secondary text-xs font-semibold text-slate-200 hover:text-white border border-white/10 transition-colors"
          >
            <span>{isFa ? 'مشاهده صفحه اختصاصی سوالات متداول (FAQ)' : 'Browse Full FAQ Directory'}</span>
            <svg class="w-3.5 h-3.5 text-parch-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('enterprise-inquiry-form') as HTMLFormElement | null;
  const msg = document.getElementById('form-success-msg');
  if (form && msg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      msg.classList.remove('hidden');
      form.reset();
    });
  }

  // Accordion toggle on contact page
  const items = document.querySelectorAll('.faq-item');
  items.forEach((item) => {
    const btn = item.querySelector('.faq-toggle');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('.faq-icon');

    if (btn && content && icon) {
      btn.addEventListener('click', () => {
        const isOpen = !content.classList.contains('hidden');
        if (isOpen) {
          content.classList.add('hidden');
          icon.classList.remove('rotate-180');
        } else {
          content.classList.remove('hidden');
          icon.classList.add('rotate-180');
        }
      });
    }
  });
</script>
