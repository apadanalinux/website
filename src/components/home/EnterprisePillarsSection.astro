---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pillars = [
  {
    title: t('enterprise.pillar1_title'),
    desc: t('enterprise.pillar1_desc'),
    tag: '5-Year LTS',
    icon: 'shield',
  },
  {
    title: t('enterprise.pillar2_title'),
    desc: t('enterprise.pillar2_desc'),
    tag: '24/7 SLA',
    icon: 'support',
  },
  {
    title: t('enterprise.pillar3_title'),
    desc: t('enterprise.pillar3_desc'),
    tag: 'Fleet Ops',
    icon: 'fleet',
  },
  {
    title: t('enterprise.pillar4_title'),
    desc: t('enterprise.pillar4_desc'),
    tag: 'Zero-Trust',
    icon: 'lock',
  },
];
---

<section id="enterprise" class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight">
        {t('enterprise.title')}
      </h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed font-light">
        {t('enterprise.subtitle')}
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-12">
      {pillars.map((pillar) => (
        <div class="rounded-lg bg-secondary p-5 border border-white/10 flex flex-col justify-between hover:border-parch-teal/40 transition-colors">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="p-2 rounded bg-[#0b1322] border border-white/10 text-parch-teal">
                {pillar.icon === 'shield' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {pillar.icon === 'support' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
                {pillar.icon === 'fleet' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                )}
                {pillar.icon === 'lock' && (
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                )}
              </div>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-[#0b1322] text-slate-300 border border-white/10">
                {pillar.tag}
              </span>
            </div>

            <h3 class="text-sm font-bold text-white">
              {pillar.title}
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed font-light">
              {pillar.desc}
            </p>
          </div>

          <div class="pt-3 mt-3 border-t border-white/5 flex items-center text-[11px] text-parch-teal font-medium">
            <span>{lang === 'fa' ? 'استاندارد سازمانی ←' : 'Enterprise standard →'}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
