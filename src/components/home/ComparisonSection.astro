---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [
  {
    feature: t('comp.row1_feat'),
    trad: t('comp.row1_trad'),
    apadana: t('comp.row1_apadana'),
  },
  {
    feature: t('comp.row2_feat'),
    trad: t('comp.row2_trad'),
    apadana: t('comp.row2_apadana'),
  },
  {
    feature: t('comp.row3_feat'),
    trad: t('comp.row3_trad'),
    apadana: t('comp.row3_apadana'),
  },
  {
    feature: t('comp.row4_feat'),
    trad: t('comp.row4_trad'),
    apadana: t('comp.row4_apadana'),
  },
  {
    feature: t('comp.row5_feat'),
    trad: t('comp.row5_trad'),
    apadana: t('comp.row5_apadana'),
  },
];
---

<section class="py-16 bg-[#020917] border-t border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-10">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight">
        {t('comp.title')}
      </h2>
    </div>

    <!-- Responsive Table -->
    <div class="overflow-x-auto rounded-lg enterprise-card border border-white/10 shadow-lg">
      <table class="w-full text-start border-collapse">
        <thead>
          <tr class="border-b border-white/10 bg-[#0e1726] text-xs font-bold">
            <th class="p-4 text-slate-300 text-start w-1/3">
              {t('comp.feature')}
            </th>
            <th class="p-4 text-slate-400 text-start w-1/3">
              {t('comp.traditional')}
            </th>
            <th class="p-4 text-parch-teal text-start w-1/3 bg-secondary/40 border-s border-white/10 font-bold">
              <span>{t('comp.apadana')}</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-xs sm:text-sm">
          {rows.map((row) => (
            <tr class="hover:bg-white/5 transition-colors">
              <td class="p-4 font-semibold text-white">
                {row.feature}
              </td>
              <td class="p-4 text-slate-400 font-light">
                <div class="flex items-start gap-2">
                  <span class="text-rose-400 shrink-0 mt-0.5">✕</span>
                  <span>{row.trad}</span>
                </div>
              </td>
              <td class="p-4 text-slate-200 bg-secondary/20 border-s border-white/10 font-medium">
                <div class="flex items-start gap-2">
                  <span class="text-parch-teal shrink-0 mt-0.5">✔</span>
                  <span>{row.apadana}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

  </div>
</section>
