---
import { useTranslations, isRTL } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const rtl = isRTL(lang);
const isFa = lang === 'fa';
---

<section class="relative pt-10 pb-16 lg:pt-16 lg:pb-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Text and Features (7 cols) -->
      <div class="col-span-12 lg:col-span-7 space-y-6 text-center lg:text-start">
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.3] lg:leading-[1.2]">
          <span>{t('hero.title_pre')}</span>
          <span class="text-parch block mt-1">
            {t('hero.title_highlight')}
          </span>
        </h1>

        <!-- Feature Grid (Parch Linux style) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-1">
          <div class="p-3.5 rounded-lg bg-secondary text-center space-y-1">
            <svg class="w-5 h-5 mx-auto text-parch-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div class="text-xs font-bold text-white">{isFa ? 'به‌روزرسانی اتمیک' : 'Atomic Updates'}</div>
            <div class="text-[10px] text-slate-400 font-light">{isFa ? 'تضمین پایداری' : 'Zero Breakage'}</div>
          </div>

          <div class="p-3.5 rounded-lg bg-secondary text-center space-y-1">
            <svg class="w-5 h-5 mx-auto text-parch-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.334 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z" />
            </svg>
            <div class="text-xs font-bold text-white">{isFa ? 'بازگشت آنی' : 'Instant Rollback'}</div>
            <div class="text-[10px] text-slate-400 font-light">{isFa ? 'بازیابی هنگام بوت' : 'Boot Recovery'}</div>
          </div>

          <div class="p-3.5 rounded-lg bg-secondary text-center space-y-1">
            <svg class="w-5 h-5 mx-auto text-parch-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <div class="text-xs font-bold text-white">{isFa ? 'بومی‌سازی فارسی' : 'Persian KDE'}</div>
            <div class="text-[10px] text-slate-400 font-light">{isFa ? 'تقویم جلالی و RTL' : 'Jalali & RTL'}</div>
          </div>

          <div class="p-3.5 rounded-lg bg-secondary text-center space-y-1">
            <svg class="w-5 h-5 mx-auto text-parch-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <div class="text-xs font-bold text-white">{isFa ? 'پشتیبانی سازمانی' : 'Enterprise SLA'}</div>
            <div class="text-[10px] text-slate-400 font-light">{isFa ? 'تعهد بلندمدت LTS' : '5-Year LTS'}</div>
          </div>
        </div>

        <!-- Description Paragraph -->
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light text-justify">
          {t('hero.description')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-2">
          <a
            href={`/${lang}/contact`}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-md text-xs font-semibold text-white bg-parch hover:opacity-90 transition-opacity"
          >
            <span>{t('hero.cta_primary')}</span>
            <svg class={`w-3.5 h-3.5 ${rtl ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={`/${lang}/docs/overview`}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-md text-xs font-medium text-slate-300 bg-secondary hover:bg-muted hover:text-white border border-white/10 transition-colors"
          >
            <span>{t('hero.cta_secondary')}</span>
          </a>
        </div>

      </div>

      <!-- Right Graphic (5 cols) -->
      <div class="col-span-12 lg:col-span-5 flex justify-center">
        <div class="relative rounded-2xl overflow-hidden border-4 border-[#1b2639] shadow-2xl max-w-md w-full">
          <img
            src="/images/bg-sm.png"
            alt="Apadana Linux Desktop"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>

    </div>

  </div>
</section>
