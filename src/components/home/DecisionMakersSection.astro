---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cards = [
  {
    icon: 'atomic',
    title: t('decision.card1_title'),
    desc: t('decision.card1_desc'),
  },
  {
    icon: 'rollback',
    title: t('decision.card2_title'),
    desc: t('decision.card2_desc'),
  },
  {
    icon: 'drift',
    title: t('decision.card3_title'),
    desc: t('decision.card3_desc'),
  },
  {
    icon: 'tco',
    title: t('decision.card4_title'),
    desc: t('decision.card4_desc'),
  },
];
---

<section id="features" class="py-16 bg-[#020917] border-t border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight">
        {t('decision.title')}
      </h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed font-light">
        {t('decision.subtitle')}
      </p>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-12">
      {cards.map((card) => (
        <div class="p-6 rounded-lg bg-secondary border border-white/10 space-y-3 hover:border-parch-teal/40 transition-colors">
          
          <div class="flex items-center gap-3">
            <div class="p-2 rounded bg-[#0b1322] border border-white/10 text-parch-teal">
              {card.icon === 'atomic' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              )}
              {card.icon === 'rollback' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.334 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z" />
                </svg>
              )}
              {card.icon === 'drift' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {card.icon === 'tco' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              )}
            </div>
            <h3 class="text-base font-bold text-white">
              {card.title}
            </h3>
          </div>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light">
            {card.desc}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>
