---
import { useTranslations, isRTL } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const rtl = isRTL(lang);
---

<section class="py-16 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="rounded-lg p-8 sm:p-12 enterprise-card border border-parch-teal/30 bg-[#071322] text-center space-y-5">
      
      <div class="max-w-3xl mx-auto space-y-3">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          {t('cta.title')}
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-light">
          {t('cta.subtitle')}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a
          href={`/${lang}/contact`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md text-xs font-semibold text-white bg-parch hover:opacity-95 shadow-sm transition-all"
        >
          <span>{t('cta.button')}</span>
          <svg class={`w-3.5 h-3.5 ${rtl ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href={`/${lang}/docs/overview`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md text-xs font-medium text-slate-300 bg-secondary hover:bg-muted hover:text-white border border-white/10 transition-colors"
        >
          <span>{t('cta.docs_btn')}</span>
        </a>
      </div>

    </div>

  </div>
</section>
