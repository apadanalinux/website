---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: lang === 'fa' ? 'ویژگی‌ها' : 'Features', href: `/${lang}/#features` },
  { label: t('nav.docs'), href: `/${lang}/docs` },
  { label: t('nav.blog'), href: `/${lang}/blog` },
  { label: t('nav.faq'), href: `/${lang}/faq` },
  { label: t('nav.relationship'), href: `/${lang}/about-parch` },
];
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#020917]/95 backdrop-blur">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href={`/${lang}/`} class="flex items-center gap-2.5">
        <img
          src="/logo-white.svg"
          alt="Parch Logo"
          class="w-7 h-7 object-contain"
        />
        <span class="font-bold text-lg text-white tracking-tight">Apadana</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== `/${lang}/` && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`text-sm font-medium transition-colors ${
                isActive
                  ? 'text-white'
                  : 'text-slate-400 hover:text-white'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions: Language & Contact Button -->
      <div class="hidden sm:flex items-center gap-3">
        <LanguageSwitcher currentLang={lang} />
        
        <a
          href={`/${lang}/contact`}
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-xs font-semibold text-white bg-parch hover:opacity-90 transition-opacity"
        >
          <span>{t('nav.contact')}</span>
        </a>
      </div>

      <!-- Mobile Button -->
      <div class="flex items-center gap-2 md:hidden">
        <LanguageSwitcher currentLang={lang} />
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-1.5 rounded-md text-slate-400 hover:text-white hover:bg-secondary focus:outline-none"
          aria-label="Menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/10 bg-[#020917] px-4 pt-2 pb-5 space-y-2">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded text-sm font-medium text-slate-300 hover:text-white hover:bg-secondary"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-2 border-t border-white/10">
      <a
        href={`/${lang}/contact`}
        class="block w-full text-center px-4 py-2 rounded text-sm font-semibold text-white bg-parch"
      >
        {t('nav.contact')}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
