---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isFa = lang === 'fa';
---

<footer class="border-t border-white/10 bg-[#020917] mt-auto pt-14 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      
      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-3">
        <div class="flex items-center gap-2.5">
          <img
            src="/logo-white.svg"
            alt="Parch Linux"
            class="w-7 h-7 object-contain"
          />
          <span class="font-bold text-lg text-white">Apadana Linux</span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed font-light">
          {t('footer.tagline')}
        </p>
      </div>

      <!-- Column 1: Product -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-4">
          {t('footer.col_product')}
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li>
            <a href={`/${lang}/#architecture`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'معماری تغییرناپذیر bootc' : 'bootc Architecture'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/#technical`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'مدل نرم‌افزارهای ایزوله' : 'Flatpak & Distrobox'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/#kde-persian`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'میزکار بومی کی دی ای پلاسما' : 'KDE Plasma & Persian'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/#enterprise`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'پایداری سازمانی و LTS' : 'LTS & SLA Guarantees'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Documentation -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-4">
          {t('footer.col_resources')}
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li>
            <a href={`/${lang}/docs/overview`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'راهنمای راه‌اندازی' : 'Getting Started Guide'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/docs/atomic-updates`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'به‌روزرسانی و Rollback' : 'Updates & Rollback'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/docs/enterprise-fleet`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'مدیریت ناوگان سازمانی' : 'Fleet Management'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/faq`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'پرسش‌های متداول' : 'Frequently Asked Questions'}
            </a>
          </li>
          <li>
            <a href={`/${lang}/blog`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'وبلاگ و اخبار مهندسی' : 'Engineering Blog'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Community & Parch Upstream -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-4">
          {t('footer.col_community')}
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li>
            <a href={`/${lang}/about-parch`} class="hover:text-parch-teal transition-colors">
              {isFa ? 'رابطه با پارچ گنو/لینوکس' : 'Apadana & Parch Lineage'}
            </a>
          </li>
          <li>
            <a href="https://t.me/apadanalinux" target="_blank" rel="noopener noreferrer" class="hover:text-parch-teal transition-colors inline-flex items-center gap-1 text-parch-teal font-medium">
              <span>{isFa ? 'کانال تلگرام آپادانا' : 'Apadana Telegram'}</span>
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.121l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.196 1.006.128.832.942z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://fosstodon.org/@apadana" target="_blank" rel="me noopener noreferrer" class="hover:text-parch-teal transition-colors inline-flex items-center gap-1 text-slate-400">
              <span>{isFa ? 'ماستودون آپادانا' : 'Apadana Mastodon'}</span>
              <svg class="w-3 h-3 text-slate-500" fill="currentColor" viewBox="0 0 448 512">
                <path d="M433 179.11c0-97.2-63.71-125.7-63.71-125.7-62.52-28.7-228.56-28.4-290.48 0 0 0-63.72 28.5-63.72 125.7 0 115.7-6.6 259.4 105.63 289.1 40.51 10.7 75.32 13 103.33 11.4 50.81-2.8 79.32-18.1 79.32-18.1l-1.7-36.9s-36.31 11.4-77.12 10.1c-40.41-1.4-83-4.4-89.63-54a102.54 102.54 0 0 1-.9-13.9c85.63 20.9 158.65 9.1 178.75 6.7 56.12-6.7 105-41.3 111.23-72.9 9.8-49.8 9.2-121.5 9.2-121.5zm-75.12 125.2h-46.5v-114.2c0-49.7-64-51.6-64 6.9v62.5h-46.3V197c0-58.5-64-56.6-64-6.9v114.2H90.6V175.81c0-94.7 71.3-95.7 71.3-95.7 45.2-.8 70.8 24.5 70.8 24.5 25.6-24.5 51.3-24.5 70.9-24.5 0 0 71.3 1 71.3 95.7v128.5z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://parchlinux.com" target="_blank" rel="noopener noreferrer" class="hover:text-parch-teal transition-colors inline-flex items-center gap-1">
              <span>{isFa ? 'وبسایت پارچ گنو/لینوکس' : 'Parch Linux Home'}</span>
              <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://forum.parchlinux.com" target="_blank" rel="noopener noreferrer" class="hover:text-parch-teal transition-colors inline-flex items-center gap-1">
              <span>{isFa ? 'تالار گفتگوی پارچ گنو/لینوکس' : 'Parch Forum'}</span>
              <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://wiki.parchlinux.com" target="_blank" rel="noopener noreferrer" class="hover:text-parch-teal transition-colors inline-flex items-center gap-1">
              <span>{isFa ? 'ویکی پارچ گنو/لینوکس' : 'Parch Wiki'}</span>
              <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>{t('footer.rights')}</p>
      <p>{t('footer.opensource_note')}</p>
    </div>
  </div>
</footer>
