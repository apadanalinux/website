---
import { getRouteForLocale } from '../i18n/utils';
import type { Locale } from '../i18n/translations';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;

const targetLang: Locale = currentLang === 'fa' ? 'en' : 'fa';
const targetUrl = getRouteForLocale(currentPath, targetLang);
---

<a
  href={targetUrl}
  class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-medium bg-secondary hover:bg-muted text-slate-300 hover:text-white border border-white/10 transition-colors"
  title={currentLang === 'fa' ? 'Switch to English' : 'تغییر به زبان فارسی'}
  aria-label={currentLang === 'fa' ? 'Switch to English' : 'تغییر به زبان فارسی'}
>
  <svg class="w-3.5 h-3.5 text-parch-teal shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
  </svg>
  <span>{currentLang === 'fa' ? 'English' : 'فارسی'}</span>
</a>
